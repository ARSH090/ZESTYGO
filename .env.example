# Copy to .env for local tooling only. Never commit .env.
# These are NON-secret identifiers. Secrets are set with:
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET --project <project>
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET --project <project>
#   firebase functions:secrets:set MAPS_SERVER_KEY --project <project>

ENV=dev
FIREBASE_PROJECT_ID=zestygo-dev
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
GOOGLE_MAPS_ANDROID_KEY=REPLACE_ME
GOOGLE_MAPS_IOS_KEY=REPLACE_ME
GOOGLE_MAPS_WEB_KEY=REPLACE_ME
